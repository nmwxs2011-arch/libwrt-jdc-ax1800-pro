# === LIBWRT CONFIG VARIANT: WIFI ===
# Target
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

# Version & Feeds
CONFIG_VERSIONOPT=y
CONFIG_VERSION_DIST="tvphus LiBwrt"
CONFIG_VERSION_FILENAMES=y
CONFIG_VERSION_CODE_FILENAMES=y
CONFIG_VERSION_REPO="https://downloads.immortalwrt.org/releases/25.12-SNAPSHOT"
# CONFIG_FEED_nss_packages is not set
# CONFIG_FEED_sqm_scripts_nss is not set
# CONFIG_FEED_video is not set
# 关键：显式启用 passwall2 feed。OpenWrt 的 FEED_* 若在 seed 里缺省，
# 首次 defconfig 会写成 not set 并被后续 defconfig 沿用，导致界面包被丢弃。
CONFIG_FEED_passwall2=y
# v5.4：passwall_packages feed 也要显式置位（它提供 xray-core/chinadns-ng 等组件）
CONFIG_FEED_passwall_packages=y

# Base System & Defaults
CONFIG_IPQ_MEM_PROFILE_512=y
CONFIG_IMAGEOPT=y
CONFIG_PREINITOPT=y
CONFIG_TARGET_DEFAULT_LAN_IP_FROM_PREINIT=y
# 管理地址改为 192.168.123.1：DEFAULT_LAN_IP_FROM_PREINIT 已开，
# 只需覆盖 preinit 值，board.d/99-lan-ip 会把它写进 board.json，
# config_generate 据此生成 /etc/config/network（比补丁更干净）。
CONFIG_TARGET_PREINIT_IP="192.168.123.1"
CONFIG_TARGET_PREINIT_NETMASK="255.255.255.0"
CONFIG_TARGET_PREINIT_BROADCAST="192.168.123.255"
CONFIG_INITOPT=y
CONFIG_PACKAGE_default-settings=y
# CONFIG_PACKAGE_default-settings-chn is not set
CONFIG_PACKAGE_zram-swap=y

# Explicit image requirements; upstream also selects these via dependencies.
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_kmod-lib-zstd=y
CONFIG_KERNEL_ZRAM_BACKEND_ZSTD=y
CONFIG_KERNEL_ZRAM_DEF_COMP_ZSTD=y
# v5.3 关键修复：LuCI 翻译包的真正开关是 LUCI_LANG_*（见 luci.mk 的
# DEFAULT:=LUCI_LANG_<lang>||(ALL&&m) 且 HIDDEN:=1），不是 CONFIG_PACKAGE_luci-i18n-*。
# 上一版只改了 PACKAGE 行、漏改这里，导致固件仍装越南语包。
CONFIG_LUCI_LANG_zh_Hans=y
# CONFIG_LUCI_LANG_vi is not set

# NSS & Wireless
# CONFIG_NSS_FIRMWARE_VERSION_11_4 is not set
CONFIG_NSS_FIRMWARE_VERSION_12_1=y
CONFIG_ATH11K_NSS_MESH_SUPPORT=y
CONFIG_PACKAGE_dawn=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_umdns=y

# VPN & Tunnels (TUN + WireGuard)
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# Networking, USB & Kernel Modules
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_kmod-ipt-offload=y
CONFIG_PACKAGE_kmod-random-core=y
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-ledtrig-usbport=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-aqc111=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-dm9601-ether=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-kaweth=y
CONFIG_PACKAGE_kmod-usb-net-lan78xx=y
CONFIG_PACKAGE_kmod-usb-net-mcs7830=y
CONFIG_PACKAGE_kmod-usb-net-pegasus=y
CONFIG_PACKAGE_kmod-usb-net-pl=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-smsc75xx=y
CONFIG_PACKAGE_kmod-usb-net-smsc95xx=y
CONFIG_PACKAGE_kmod-usb-net-sr9700=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-ch341=y
CONFIG_PACKAGE_kmod-usb-serial-cp210x=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y
CONFIG_PACKAGE_kmod-usb-serial-pl2303=y
CONFIG_PACKAGE_kmod-usb-wdm=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_r8152-firmware=y
CONFIG_PACKAGE_watchcat=y

# LuCI Applications & Themes
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
# CONFIG_PACKAGE_luci-app-cpufreq is not set
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-vnstat2=y
CONFIG_PACKAGE_luci-compat=y
# ---------- 简体中文界面（v5.3：LUCI_LANG_zh_Hans 已在上面置 y，语言包自动生成）----------
# 下面 PACKAGE 行做冗余保险；真正决定语言包的是上面的 LUCI_LANG 开关。
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
CONFIG_PACKAGE_luci-i18n-vnstat2-zh-cn=y

# ============================================================
# AX1800 Pro (RE-SS-01) 定制软件包片段（去重修正版）
# 说明：以下只保留 seed 中原本没有的新增包。
#       kmod-tun / zram-swap / mwan3 / luci-app-mwan3 / luci-app-ttyd
#       已在上面 seed 中启用，不再重复声明。
# ============================================================

# ---------- 1. USB 打印共享 (p910nd) ----------
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_p910nd=y
CONFIG_PACKAGE_luci-app-usb-printer=y
CONFIG_PACKAGE_usbutils=y

# ---------- 2. USB 扫描共享 (SANE) ----------
# 25.12 已重组为 sane-backends 源包；旧名 sane-utils/saned 不存在，
# 用主包 + epson2 后端 + 服务端 + 前端工具的正确组合。
CONFIG_PACKAGE_sane-backends=y
CONFIG_PACKAGE_sane-epson2=y
CONFIG_PACKAGE_sane-daemon=y
CONFIG_PACKAGE_sane-frontends=y
CONFIG_PACKAGE_xinetd=y

# ---------- 3. PassWall 2 (sing-box 默认内核) ----------
# passwall2 feed 已在 libwrt.sh 精确注册（同时写 feeds.conf），界面包可见。
# lyaml 为其 LUCI_DEPENDS，显式声明做保险。
CONFIG_PACKAGE_luci-app-passwall2=y
# v5.4：显式选 sing-box 单核心，避开默认 Basic_Core_All 去 select xray-core
# （passwall_packages feed 未被扫描时 xray-core 符号缺失，会拖垮整个界面包）
CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_SingBox=y
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_All is not set
# CONFIG_PACKAGE_luci-app-passwall2_Basic_Core_Xray is not set
CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn=y
CONFIG_PACKAGE_sing-box=y
CONFIG_PACKAGE_tcping=y
CONFIG_PACKAGE_geoview=y
CONFIG_PACKAGE_v2ray-geoip=y
CONFIG_PACKAGE_v2ray-geosite=y
CONFIG_PACKAGE_lyaml=y
# v5.3 关键修复：以下 7 项是 luci-app-passwall2 的 LUCI_DEPENDS 成员。
# 上一版未显式声明，make defconfig 不会自动补依赖，界面包因此被丢弃。
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_coreutils-nohup=y
CONFIG_PACKAGE_coreutils-timeout=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_libuci-lua=y
CONFIG_PACKAGE_unzip=y
